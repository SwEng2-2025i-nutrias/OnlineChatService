# =============================================================================
# CONFIGURACIÓN DEL ENTORNO - OnlineChatService
# =============================================================================
# Copia este archivo como .env y configura las variables según tu entorno

# =============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# =============================================================================

# Host y puerto del servidor
HOST=0.0.0.0
PORT=8000

# Modo debug (true/false)
DEBUG=false

# =============================================================================
# CONFIGURACIÓN DE AUTENTICACIÓN
# =============================================================================

# Usar servicio mock de autenticación para desarrollo/testing (true/false)
USE_MOCK_AUTH=true

# Clave secreta para JWT (cambiar en producción)
JWT_SECRET_KEY=test-secret-key-only-for-development

# URL del servicio de autenticación externo (si USE_MOCK_AUTH=false)
AUTH_SERVICE_URL=http://localhost:5001/auth/validate-token

# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =============================================================================

# URL de conexión a MongoDB
MONGODB_URL=mongodb://localhost:27017

# Nombre de la base de datos
DATABASE_NAME=chat_service

# =============================================================================
# CONFIGURACIÓN DE WEBSOCKET
# =============================================================================

# Configuraciones adicionales para Socket.IO (si es necesario)
CORS_ORIGINS=*

# =============================================================================
# CONFIGURACIÓN DE DESARROLLO
# =============================================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Configuración para testing
TESTING_MODE=false
